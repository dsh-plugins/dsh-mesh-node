{
  "name": "@dsh-prism/dsh-mesh-node",
  "description": "Delegate Prism tasks to the device that hosts each project and return progress to the coordinating host.",
  "version": "0.2.2",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist/",
    "!dist/*.test.*",
    "!dist/*.tsbuildinfo",
    "!dist/*probe.*",
    "locale/*.json",
    "icon.svg",
    "README.zh_CN.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24.0.0",
    "dsh": "0.2.3-alpha.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.2.3-alpha.2",
    "@dsh-prism/dsh-orchestrator": "^0.2.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.release.json",
    "test": "node --test test/mesh.test.mjs test/pairing.test.mjs test/turn.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-mesh-node.git"
  },
  "devDependencies": {
    "@dsh-plugin/dsh-loader": "2.0.0-dev.45752173879",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "typescript": "6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "lemon-tls": "0.12.2",
    "turn-server": "0.10.0",
    "werift": "0.29.0",
    "ws": "8.23.0"
  },
  "bin": {
    "dsh-prism-mesh-signaling": "./dist/signaling-cli.js"
  }
}
